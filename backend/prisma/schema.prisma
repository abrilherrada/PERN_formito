generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String             @id @default(cuid())
  name                    String
  email                   String             @unique
  password                String
  role                    UserRole           @default(USER)
  status                  EntityStatus       @default(ACTIVE)
  plan                    Plan               @default(FREE)
  maxSubmissions          Int                @default(50)
  currentSubmissions      Int                @default(0)
  lastSubmissionResetAt   DateTime?
  nextSubmissionResetAt   DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  deletedAt               DateTime?
  purgedAt                DateTime?
  forms                   Form[]
  verificationTokens      VerificationToken[]
  userEmails              UserEmail[]
  sessionTokens           SessionToken[]
  submissionUsageResets   SubmissionUsageReset[]
}

model Form {
  id               String       @id @default(cuid())
  name             String
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  destinationEmail String
  status           EntityStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?
  purgedAt         DateTime?
  submissions      Submission[]
}

model Submission {
  id        String       @id @default(cuid())
  formId    String
  form      Form         @relation(fields: [formId], references: [id])
  data      Json
  metadata  Json?
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  deletedAt DateTime?
  purgedAt  DateTime?
}

model SubmissionUsageReset {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  submissionsCount  Int
  maxSubmissions    Int
  plan              Plan
  resetAt           DateTime @default(now())
  triggeredBy       String
  createdAt         DateTime @default(now())
}

model UserEmail {
  id              String                    @id @default(cuid())
  userId          String
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email           String                    @unique
  isPrimary       Boolean                   @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  purgedAt        DateTime?
  verificationTokens VerificationToken[]
}

model VerificationToken {
  id            String                        @id @default(cuid())
  tokenSelector String                        @unique
  tokenHash     String
  type          VerificationTokenType         @default(ACCOUNT_EMAIL)
  userId        String?
  user          User?                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmailId   String?
  userEmail     UserEmail?                    @relation(fields: [userEmailId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime                      @default(now())
}

model SessionToken {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String         @unique
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime       @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?
  replacedByTokenId String?        @unique
  replacedByToken   SessionToken?  @relation("SessionTokenReplacement", fields: [replacedByTokenId], references: [id])
  rotatedFrom       SessionToken?  @relation("SessionTokenReplacement")

  @@index([userId])
  @@index([tokenHash])
}

enum Plan {
  FREE
  PREMIUM
}

enum VerificationTokenType {
  ACCOUNT_EMAIL
  SECONDARY_EMAIL
  PASSWORD_RESET
}

enum UserRole {
  USER
  ADMIN
}

enum EntityStatus {
  ACTIVE
  SUSPENDED
  DELETED
}